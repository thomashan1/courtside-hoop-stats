<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the app to accept CloudKit share invitations (#57).
	     Without it, tapping a share link does not open the app and
	     userDidAcceptCloudKitShareWith is never called — a silent failure
	     that only shows up when a real invitee taps a real link. -->
	<key>CKSharingSupported</key>
	<true/>
	<!-- Other names Siri accepts for the app in a phrase (#255): the
	     home-screen label is "Courtside", the App Store name is longer. -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Courtside Hoop Stats</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Hoop Stats</string>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
